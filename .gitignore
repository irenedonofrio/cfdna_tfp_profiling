cat > .gitignore << 'EOF'
# PyCharm
.idea/

# Python
__pycache__/
*.pyc
*.egg-info/
.ipynb_checkpoints/
venv/
.venv/
env/                      # <-- REMOVE this line if env/ holds conda .yml configs you want to keep
*.conda
*.egg

# Generated output
demo_out/
results/
outputs/

# Large data / bioinformatics artifacts — never version these
*.bam
*.bai
*.cram
*.fastq
*.fq
*.fastq.gz
*.fq.gz
*.vcf
*.vcf.gz
*.bed.gz
*.bw
*.bigWig
*.h5
*.hdf5
*.npy
*.npz
*.pt
*.pkl

# OS
.DS_Store
EOF

# Test working directories (regenerated by golden/sparse tests)
*_test_work/

# Logs
*.log
